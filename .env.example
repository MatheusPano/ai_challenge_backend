DB_HOST=localhost
DB_PORT=3306
DB_USER=app
DB_PASSWORD=app
DB_ROOT_PASSWORD=root
DB_NAME=ai_challenge

# RAG (pgvector)
RAG_DB_HOST=localhost
RAG_DB_PORT=5432
RAG_DB_USER=rag
RAG_DB_PASSWORD=rag
RAG_DB_NAME=ai_challenge_rag
# Set RAG_DB_SSL=true when using AWS RDS / Aurora / any managed Postgres
RAG_DB_SSL=false

# Gemini
GEMINI_API_KEY=
GEMINI_EMBEDDING_MODEL=gemini-embedding-001
GEMINI_EMBEDDING_DIMS=768

# QuizService LLM stack:
#  - QUIZ_MODEL: primary model (default gemma — large free-tier quota,
#    ~14k RPD). May occasionally emit malformed JSON.
#  - QUIZ_FALLBACK_MODEL: tried automatically when the primary fails
#    (quota exhausted or invalid JSON). Default gemini-2.5-flash-lite
#    uses a separate economy quota tier and supports native responseSchema.
QUIZ_MODEL=gemini-2.5-flash
QUIZ_FALLBACK_MODEL=gemini-2.5-flash-lite

# LLM provider: "gemini" (default, uses Gemini API) or "ollama" (local, free).
# For "ollama" set LLM_PROVIDER=ollama and have Ollama running locally:
#   brew install ollama && ollama serve
#   ollama pull qwen2.5:7b-instruct
# Embeddings always use Gemini (free tier is generous and re-indexing RAG
# with another model would invalidate stored vectors).
LLM_PROVIDER=gemini
OLLAMA_URL=http://host.docker.internal:11434
OLLAMA_MODEL=qwen2.5:7b-instruct

# Ingest
RAG_DATA_DIR=src/rag/data
